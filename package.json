{
  "name": "hackaton2026",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm --prefix ./client run dev\" \"npm --prefix ./server run dev\"",
